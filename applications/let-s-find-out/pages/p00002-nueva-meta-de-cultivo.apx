page 2 (
    name: Nueva meta de cultivo
    alias: NUEVA-META-DE-CULTIVO
    title: Nueva meta de cultivo
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region nueva-meta-de-cultivo (
        name: Nueva meta de cultivo
        type: form
        source {
            location: localDatabase
            type: tableView
            tableName: LFO_METAS_CULTIVO
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
            ]
        }
    )

    pageItem P2_ID (
        type: hidden
        layout {
            sequence: 10
            region: @nueva-meta-de-cultivo
            slot: regionBody
        }
        source {
            formRegion: @nueva-meta-de-cultivo
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P2_MINUTOS_MINIMOS (
        type: numberField
        label {
            label: Mínimo por sesión (minutos)
            alignment: left
        }
        layout {
            sequence: 50
            region: @nueva-meta-de-cultivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @nueva-meta-de-cultivo
            column: MINUTOS_MINIMOS
            dataType: number
        }
    )

    pageItem P2_NOMBRE (
        type: textField
        label {
            label: Actividad
            alignment: left
        }
        layout {
            sequence: 40
            region: @nueva-meta-de-cultivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 100
        }
        source {
            formRegion: @nueva-meta-de-cultivo
            column: NOMBRE
            dataType: varchar2
        }
    )

    pageItem P2_PERSONA (
        type: hidden
        layout {
            sequence: 20
            region: @nueva-meta-de-cultivo
            slot: regionBody
        }
        source {
            formRegion: @nueva-meta-de-cultivo
            column: PERSONA
            dataType: varchar2
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P2_SEMANA_INICIO (
        type: hidden
        layout {
            sequence: 30
            region: @nueva-meta-de-cultivo
            slot: regionBody
        }
        appearance {
            formatMask: YYYY-MM-DD
        }
        source {
            formRegion: @nueva-meta-de-cultivo
            column: SEMANA_INICIO
            dataType: date
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P2_VECES_POR_SEMANA (
        type: numberField
        label {
            label: Veces por semana
            alignment: left
        }
        layout {
            sequence: 60
            region: @nueva-meta-de-cultivo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @nueva-meta-de-cultivo
            column: VECES_POR_SEMANA
            dataType: number
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @nueva-meta-de-cultivo
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @nueva-meta-de-cultivo
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P2_ID
        }
    )

    process initialize-form-nueva-meta-de-cultivo (
        name: Initialize form Nueva meta de cultivo
        type: formInitialization
        formRegion: @nueva-meta-de-cultivo
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 9565084867871101
        }
    )

    process cargar-semana (
        name: Cargar semana seleccionada
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P2_PERSONA := lfo_persona_actual;
                :P2_SEMANA_INICIO := nvl(apex_util.get_preference('LFO_SEMANA', :APP_USER), to_char(trunc(cast(systimestamp at time zone 'America/Argentina/Buenos_Aires' as date), 'IW'), 'YYYY-MM-DD'));
                ```
        }
        execution {
            sequence: 20
            point: beforeHeader
        }
    )

    process asegurar-semana (
        name: Asegurar semana seleccionada
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P2_PERSONA := lfo_persona_actual;
                :P2_SEMANA_INICIO := nvl(apex_util.get_preference('LFO_SEMANA', :APP_USER), to_char(trunc(cast(systimestamp at time zone 'America/Argentina/Buenos_Aires' as date), 'IW'), 'YYYY-MM-DD'));
                ```
        }
        execution {
            sequence: 1
            point: afterSubmit
        }
    )

    process process-form-nueva-meta-de-cultivo (
        name: Process form Nueva meta de cultivo
        type: formAutoRowProcessing
        formRegion: @nueva-meta-de-cultivo
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
        advanced {
            executionMappingIdentifier: 9565442526871104
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 1
            }
        }
    )

)
