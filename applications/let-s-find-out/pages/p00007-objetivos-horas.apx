page 7 (
    name: Objetivos de horas
    alias: OBJETIVOS-HORAS
    title: Objetivos de horas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authentication: required
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    region objetivos (
        name: Mis objetivos de horas
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Indicá tus horas para la semana seleccionada. Podés usar fracciones, por ejemplo 1,5 para una hora y media. Dejá vacío si no tenés objetivo en una categoría. Las horas de Cultivo se calculan a partir de tus metas de Cultivo.</p>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )
    pageItem P7_TRABAJO (
        type: numberField
        label {
            label: Trabajo (horas)
            alignment: above
        }
        layout {
            sequence: 10
            region: @objetivos
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
        }
    )
    pageItem P7_ESTUDIO (
        type: numberField
        label {
            label: Estudio (horas)
            alignment: above
        }
        layout {
            sequence: 20
            region: @objetivos
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
        }
    )
    pageItem P7_OCIO (
        type: numberField
        label {
            label: Ocio (horas)
            alignment: above
        }
        layout {
            sequence: 30
            region: @objetivos
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
        }
    )
    pageItem P7_SEMANA (
        type: hidden
        layout {
            sequence: 45
            region: @objetivos
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )
    button guardar (
        buttonName: GUARDAR
        label: Guardar objetivos
        layout {
            sequence: 50
            region: @objetivos
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
        }
    )
    process cargar-objetivos (
        name: Cargar objetivos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    v_persona varchar2(4) := lfo_persona_actual;
                    v_trabajo number; v_estudio number; v_ocio number;
                    v_semana date := to_date(nvl(apex_util.get_preference('LFO_SEMANA', :APP_USER), to_char(trunc(cast(systimestamp at time zone 'America/Argentina/Buenos_Aires' as date), 'IW'), 'YYYY-MM-DD')), 'YYYY-MM-DD');
                begin
                    select max(case when categoria = 'TRABAJO' then horas_objetivo end),
                           max(case when categoria = 'ESTUDIO' then horas_objetivo end),
                           max(case when categoria = 'OCIO' then horas_objetivo end)
                    into v_trabajo, v_estudio, v_ocio
                    from lfo_objetivos_horas where persona = v_persona and semana_inicio = v_semana;
                    :P7_SEMANA := to_char(v_semana, 'YYYY-MM-DD');
                    :P7_TRABAJO := v_trabajo;
                    :P7_ESTUDIO := v_estudio;
                    :P7_OCIO := v_ocio;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )
    process guardar-objetivos (
        name: Guardar objetivos
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    v_cultivo_anterior number;
                    v_semana date := to_date(:P7_SEMANA, 'FXYYYY-MM-DD');
                begin
                    select max(horas_objetivo) into v_cultivo_anterior
                    from lfo_objetivos_horas
                    where persona=lfo_persona_actual and semana_inicio=v_semana and categoria='CULTIVO';
                    lfo_objetivos_horas_api.guardar(
                        apex_session_state.get_number('P7_TRABAJO'),
                        apex_session_state.get_number('P7_ESTUDIO'),
                        apex_session_state.get_number('P7_OCIO'),
                        v_cultivo_anterior,
                        v_semana
                    );
                end;
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        serverSideCondition {
            whenButtonPressed: @guardar
        }
        successMessage {
            successMessage: Objetivos guardados.
        }
    )
    branch volver (
        name: Ver progreso
        execution {
            sequence: 10
            point: afterProcessing
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 8
                clearCache: 8
            }
        }
    )
)
