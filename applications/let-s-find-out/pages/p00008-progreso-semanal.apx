page 8 (
    name: Progreso semanal
    alias: PROGRESO-SEMANAL
    title: Progreso semanal
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authentication: required
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    css {
        inline:
            ```css
            .lfo-tabla-semanal { overflow-x: auto; }
            .lfo-tabla-semanal table { width: 100%; min-width: 620px; }
            .lfo-tabla-semanal th, .lfo-tabla-semanal td { padding: 12px 20px; }
            ```
    }
    region progreso (
        name: Progreso de la semana
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                    v_semana date := to_date(nvl(apex_util.get_preference('LFO_SEMANA', :APP_USER), to_char(trunc(cast(systimestamp at time zone 'America/Argentina/Buenos_Aires' as date), 'IW'), 'YYYY-MM-DD')), 'YYYY-MM-DD');
                    v_hoy date := cast(systimestamp at time zone 'America/Argentina/Buenos_Aires' as date);
                    v_html clob := '<p>Semana: <strong>' || to_char(v_semana, 'DD/MM/YYYY') || ' al ' || to_char(v_semana + 6, 'DD/MM/YYYY') || '</strong> | Hoy: ' || to_char(v_hoy, 'DD/MM/YYYY') || '</p>';
                    v_faltan number;
                    v_dias_activos number;
                    v_puntos_constancia number;
                    v_metas_total number;
                    v_metas_completadas number;
                    v_metas_puntos number;
                    function duracion(p_segundos number) return varchar2 is
                      v_segundos number := floor(greatest(nvl(p_segundos,0),0));
                    begin
                      return to_char(floor(v_segundos/3600),'FM999999990') || ' h ' || to_char(floor(mod(v_segundos,3600)/60),'FM00') || ' min ' || to_char(mod(v_segundos,60),'FM00') || ' s';
                    end;
                begin
                    for persona in (select distinct persona from lfo_cuentas_persona order by persona) loop
                        v_html := v_html || '<h3>' || apex_escape.html(persona.persona) || '</h3><div class="t-Report lfo-tabla-semanal"><table class="t-Report-report"><thead><tr><th scope="col">Categoría</th><th scope="col">Registrado</th><th scope="col">Objetivo</th><th scope="col">Hasta el objetivo</th><th scope="col">Puntos</th></tr></thead><tbody>';
                        for r in (
                            select c.categoria, c.etiqueta, p.segundos,
                                   case when c.categoria='CULTIVO' then cultivo.horas_objetivo else p.horas_objetivo end horas_objetivo
                            from (select 'TRABAJO' categoria, 'Trabajo' etiqueta, 1 orden from dual union all
                                  select 'ESTUDIO', 'Estudio', 2 from dual union all
                                  select 'OCIO', 'Ocio', 3 from dual union all
                                  select 'CULTIVO', 'Cultivo', 4 from dual) c
                            left join lfo_progreso_horas_v p on p.persona = persona.persona and p.semana_inicio = v_semana and p.categoria = c.categoria
                            left join lfo_objetivo_cultivo_v cultivo on cultivo.persona = persona.persona and cultivo.semana_inicio = v_semana and c.categoria='CULTIVO'
                            order by c.orden
                        ) loop
                            v_html := v_html || '<tr><td>' || apex_escape.html(r.etiqueta) || '</td><td>' || duracion(r.segundos) || '</td>';
                            if r.horas_objetivo is null then
                                v_html := v_html || '<td>Sin objetivo</td><td>—</td>';
                            else
                                v_faltan := greatest(0, round(r.horas_objetivo * 3600) - floor(nvl(r.segundos, 0)));
                                v_html := v_html || '<td>' || duracion(round(r.horas_objetivo * 3600)) || '</td><td>' || duracion(v_faltan) || '</td>';
                            end if;
                            if r.categoria in ('TRABAJO','ESTUDIO') and r.horas_objetivo is not null then
                                v_html := v_html || '<td>' || lfo_puntos_horas(r.segundos,r.horas_objetivo) || ' de 5</td>';
                            else
                                v_html := v_html || '<td>—</td>';
                            end if;
                            v_html := v_html || '</tr>';
                        end loop;
                        v_html := v_html || '</tbody></table></div>';
                        select nvl(max(dias_activos),0), nvl(max(puntos),0)
                        into v_dias_activos, v_puntos_constancia
                        from lfo_constancia_semanal_v
                        where persona=persona.persona and semana_inicio=v_semana;
                        v_html := v_html || '<p>Constancia: <strong>' || v_dias_activos || ' días activos | ' || v_puntos_constancia || ' de 5 puntos</strong></p>';
                        select nvl(max(m.total),0), nvl(max(m.completadas),0), max(m.puntos)
                        into v_metas_total, v_metas_completadas, v_metas_puntos
                        from lfo_resumen_metas_semanales_v m
                        where m.persona=persona.persona and m.semana_inicio=v_semana;
                        if v_metas_total=0 then
                            v_html := v_html || '<p>Metas semanales: <strong>Sin metas</strong></p>';
                        else
                            v_html := v_html || '<p>Metas semanales: <strong>' || v_metas_completadas || ' de ' || v_metas_total || ' completadas | ' || to_char(round(v_metas_puntos,2),'FM990D00') || ' de 5 puntos</strong></p>';
                        end if;
                    end loop;
                    return v_html || '<p>El objetivo de Cultivo suma los mínimos de cada actividad multiplicados por sus veces semanales. Los puntos son parciales: se calculan Trabajo y Estudio con objetivo, Constancia y Metas semanales. Un día activo requiere una hora de Trabajo o Estudio, por separado. El tiempo proviene de cronómetros asociados a un día personal; no incluye intervalos anteriores sin día ni sesiones manuales de Cultivo.</p>';
                end;
                ```
        }
        layout {
            sequence: 10
            slot: body
            columnSpan: 12
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )
)
