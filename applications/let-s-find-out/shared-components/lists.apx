list navigation-bar (
    name: Navigation Bar

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry home (
        label: Inicio
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry tiempo (
        label: Tiempo
        icon {
            imageIconCssClasses: fa-clock-o
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                type: url
                url: #
            }
        }
    )

    entry mis-registros (
        label: Mis registros
        icon {
            imageIconCssClasses: fa-list
        }
        layout {
            sequence: 10
            parentEntry: @tiempo
        }
        link {
            target: {
                page: 11
                clearCache: 11
            }
        }
    )

    entry cargar-tiempo-manual (
        label: Cargar tiempo
        icon {
            imageIconCssClasses: fa-plus-circle
        }
        layout {
            sequence: 20
            parentEntry: @tiempo
        }
        link {
            target: {
                page: 13
                clearCache: 13
            }
        }
    )

    entry cierre-diario (
        label: Cierre del día
        icon {
            imageIconCssClasses: fa-calendar-check-o
        }
        layout {
            sequence: 30
            parentEntry: @tiempo
        }
        link {
            target: {
                page: 5
                clearCache: 5
            }
        }
    )

    entry metas (
        label: Metas
        icon {
            imageIconCssClasses: fa-bullseye
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                type: url
                url: #
            }
        }
    )

    entry registrar-cultivo (
        label: Cultivo
        icon {
            imageIconCssClasses: fa-leaf
        }
        layout {
            sequence: 10
            parentEntry: @metas
        }
        link {
            target: {
                page: 3
                clearCache: 3
            }
        }
    )

    entry nueva-meta-de-cultivo (
        label: Nueva meta de Cultivo
        icon {
            imageIconCssClasses: fa-plus
        }
        layout {
            sequence: 20
            parentEntry: @metas
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry metas-semanales (
        label: Metas semanales
        icon {
            imageIconCssClasses: fa-check-square-o
        }
        layout {
            sequence: 30
            parentEntry: @metas
        }
        link {
            target: {
                page: 10
                clearCache: 10
            }
        }
    )

    entry objetivos-horas (
        label: Objetivos de horas
        icon {
            imageIconCssClasses: fa-hourglass-half
        }
        layout {
            sequence: 40
            parentEntry: @metas
        }
        link {
            target: {
                page: 7
                clearCache: 7
            }
        }
    )

    entry resultados (
        label: Progreso
        icon {
            imageIconCssClasses: fa-bar-chart
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                type: url
                url: #
            }
        }
    )

    entry progreso-semanal (
        label: Progreso semanal
        icon {
            imageIconCssClasses: fa-line-chart
        }
        layout {
            sequence: 10
            parentEntry: @resultados
        }
        link {
            target: {
                page: 8
                clearCache: 8
            }
        }
    )

    entry cierre-semanal (
        label: Cierre semanal
        icon {
            imageIconCssClasses: fa-calendar-check-o
        }
        layout {
            sequence: 20
            parentEntry: @resultados
        }
        link {
            target: {
                page: 15
                clearCache: 15
            }
        }
    )

    entry recuento-mensual (
        label: Recuento mensual
        icon {
            imageIconCssClasses: fa-calendar
        }
        layout {
            sequence: 30
            parentEntry: @resultados
        }
        link {
            target: {
                page: 16
                clearCache: 16
            }
        }
    )

    entry colores (
        label: Colores
        icon {
            imageIconCssClasses: fa-paint-brush
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 6
                clearCache: 6
            }
        }
    )

)
