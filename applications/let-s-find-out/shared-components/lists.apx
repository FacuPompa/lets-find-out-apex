list navigation-bar (
    name: Navigation Bar

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry nueva-meta-de-cultivo (
        label: Nueva meta de cultivo
        icon {
            imageIconCssClasses: fa-forms
        }
        layout {
            sequence: 20
        }
        isCurrent {
            type: pages
            pages: 2
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry colores (
        label: Colores de cronómetros
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 6
                clearCache: 6
            }
        }
    )

    entry objetivos-horas (
        label: Mis objetivos de horas
        layout {
            sequence: 60
        }
        link {
            target: {
                page: 7
                clearCache: 7
            }
        }
    )

    entry progreso-semanal (
        label: Progreso semanal
        layout {
            sequence: 70
        }
        link {
            target: {
                page: 8
                clearCache: 8
            }
        }
    )

    entry metas-semanales (
        label: Mis metas semanales
        layout {
            sequence: 80
        }
        link {
            target: {
                page: 10
                clearCache: 10
            }
        }
    )

    entry cierre-diario (
        label: Cierre del día
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 5
                clearCache: 5
            }
        }
    )

    entry registrar-cultivo (
        label: Registrar cultivo
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 3
                clearCache: 3
            }
        }
    )

)
